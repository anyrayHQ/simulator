# Copy to .env. Gitignored.
#
# This experiment needs BOTH arms, and the direct arm needs a provider key of
# your own. That is the cost of answering the question honestly: without a
# genuinely direct control, "with Anyray vs without" is really "with Anyray vs
# Anyray forwarding unchanged".

# The model. No default: every deployment routes a different set.
EXPERIMENT_MODEL=claude-sonnet-4-5

# --- arm: anyray (through your gateway, the ordinary request) ---
ANYRAY_GATEWAY_URL=https://gateway.example.com
ANYRAY_API_KEY=ark_your_client_key_here

# --- arm: direct (your provider, nothing of ours in the path) ---
# An OpenAI-compatible base URL. Deliberately NOT read from OPENAI_API_KEY or
# ANTHROPIC_API_KEY: on a machine enrolled with Anyray those are part of the
# routing, and borrowing one makes this control a second gateway arm.
DIRECT_BASE_URL=https://api.openai.com/v1
DIRECT_API_KEY=sk-your-own-provider-key
# If the provider serves the model under a different id than the gateway does:
# DIRECT_MODEL=
