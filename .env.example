# Copy to .env and fill in. `.env` is gitignored.
#
#   cp .env.example .env
#
# The setup prompt (SETUP-PROMPT.md) fills this in for you and verifies that a
# request actually succeeds before it goes any further.

# Your Anyray gateway — the same base URL your tools already send model calls
# to. No trailing /v1; the script adds the path.
ANYRAY_GATEWAY_URL=https://gateway.example.com

# An Anyray client key (ark_...). A client key, not an admin token: this repo
# only ever sends ordinary inference requests.
ANYRAY_API_KEY=ark_your_client_key_here

# The model to prove it on. THIS HAS NO SAFE DEFAULT: every deployment routes a
# different set, and a model your gateway does not serve fails on the first
# call. Use the one your app already sends — savings depend on the prompt, not
# the model, but the dollar figure depends on that model's rate. Your Anyray
# console lists what this gateway serves.
#
# Not Claude-specific: any model your gateway routes works, on either dialect.
# rates.json prices the published catalogue; anything else reports tokens only.
PROOF_MODEL=

# Runs per arm. Each workload costs 2 x PROOF_REPEATS provider calls, on your
# bill. 3 is enough to tell a real change from ordinary run-to-run variation;
# 1 is a smoke test, not a proof.
PROOF_REPEATS=3

# API dialect. /v1/chat/completions (OpenAI-compatible) or /v1/messages
# (Anthropic-native). Both work; pick the one your app uses.
PROOF_ENDPOINT=/v1/chat/completions

# Cap on the answer length, so a runaway generation can't dominate your bill.
PROOF_MAX_TOKENS=1024

# --- Optional third arm: a genuinely direct call ---
#
# Both normal arms go through your Anyray gateway — one with optimization
# bypassed. So "without Anyray" really means "Anyray forwarding unchanged", and
# a careful evaluator will ask whether the proxy itself changes anything.
#
# Set these and the run adds a third call straight to your provider, with no
# Anyray in the path at all, then reports whether the bypassed arm and the
# direct call agree on input tokens. They should be identical; if they are not,
# the run says so, because that is a finding about us.
#
# This costs one extra call per repeat per workload, and needs YOUR provider
# key. It is deliberately a separate variable: on an enrolled machine
# ANTHROPIC_API_KEY / OPENAI_API_KEY are part of the Anyray routing, so
# borrowing one would make the "direct" arm a second gateway arm.
# DIRECT_BASE_URL=https://api.anthropic.com
# DIRECT_API_KEY=sk-ant-your-own-provider-key
# DIRECT_DIALECT=anthropic      # detected from the URL; override if wrong
