# Copy to .env and fill in two values. `.env` is gitignored.
#
#   cp .env.example .env
#
# There is no Anyray account, no Anyray key, and no signup. The optimizer runs
# in a container on this machine; the only credential here is your own
# provider key, used to call your own provider directly.

# --- Your provider (the only thing this tool talks to over the network) ---

# Anthropic:        https://api.anthropic.com
# OpenAI:           https://api.openai.com
# A local model:    http://localhost:11434/v1   (Ollama, vLLM, LM Studio …)
#                   With a local model, nothing leaves this machine at all.
PROVIDER_BASE_URL=https://api.anthropic.com

# Your own provider key. Never sent to Anyray — the optimizer is a local
# container and is not in this request's path.
PROVIDER_API_KEY=sk-ant-your-own-key-here

# Auth and endpoint shape. Detected from the base URL; set it only if the
# detection is wrong (a proxy, or a self-hosted model on an unusual host).
# PROVIDER_DIALECT=anthropic        # or: openai

# The model to prove it on. Use one you actually run — the saving depends on
# your prompts, but the dollar figure depends on the model's rate.
PROOF_MODEL=claude-sonnet-5

# --- The local optimizer container ---

# Where `docker compose up` put it. Localhost by design.
OPTIMIZER_URL=http://localhost:8088

# --- The run ---

# Runs per arm. Each workload costs 2 x PROOF_REPEATS provider calls, on your
# bill. 3 is enough to tell a real change from ordinary run-to-run variation;
# 1 is a smoke test, not a proof.
PROOF_REPEATS=3

# Cap on answer length, so a runaway generation can't dominate your bill.
PROOF_MAX_TOKENS=1024

# How long to wait for the container's embedding model to load before giving
# up. Measuring a cold optimizer measures a different pipeline, so this waits.
# PROOF_READY_TIMEOUT_MS=180000

# Override the request path if your provider needs a different one.
# PROOF_ENDPOINT=/v1/messages
